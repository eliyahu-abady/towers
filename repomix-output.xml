          >
            אימתתי, תן לי להיכנס
          </button>
        </div>

        <button
          onClick={handleSignOut}
          className="w-full mt-6 text-sm font-medium text-slate-400 hover:text-red-500 transition-colors underline underline-offset-4 cursor-pointer"
        >
          התנתקות מהחשבון
